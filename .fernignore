# Specify files that shouldn't be modified by Fern
core/request_option_custom.go
option/request_option_custom.go
tests/
changelog.md

# Wrapper layer - custom code that should not be overwritten
agentkit/
v3/
client/client.go
agents/start_map.go

# Documentation - managed manually, not generated by Fern
docs/
README.md
reference.md

# CI/release automation is managed manually
.github/workflows/

# Build tooling - managed manually, not generated by Fern
scripts/

# Dependency manifests are managed manually
go.mod
go.sum
.fern/replay.lock
.fern/replay.yml
.gitattributes

# Public token policy and shared transport corrections are hand-maintained.
core/request_option.go
option/request_option.go
internal/caller.go
internal/caller_auth_test.go
internal/retrier.go
agent_session_info.go
